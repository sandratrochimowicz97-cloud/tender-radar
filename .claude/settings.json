{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.mcp.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.credentials.json)",
      "Read(~/.n8n/**)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.js"
            ]
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.n8n",
        "~/.ssh"
      ]
    }
  }
}
