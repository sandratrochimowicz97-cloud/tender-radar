# Copy to .env and fill in. .env is gitignored and never committed.
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tender_radar
POSTGRES_PORT=5432
N8N_PORT=5679

# The Anthropic API key is not kept here: n8n stores it as an encrypted credential (see README).

# Password for the read-only login the MCP server uses (db/mcp-reader.sql). Pick a long random one.
MCP_READER_PASSWORD=
